  ;; Subscripts and superscripts, typed directly: _1 gives ₁, ^2 gives ².
  ;; This map is used only in state main1: in state main2 (after a
  ;; backslash), \_ and \^ give the plain characters _ and ^, also
  ;; when a digit or a letter follows.
  (scripts
    ("_1"                  "₁")
    ("_2"                  "₂")
    ("_3"                  "₃")
    ("_4"                  "₄")
    ("_5"                  "₅")
    ("_6"                  "₆")
    ("_7"                  "₇")
    ("_8"                  "₈")
    ("_9"                  "₉")
    ("_0"                  "₀")
    ("_+"                  "₊")
    ("_-"                  "₋")
    ("_="                  "₌")
    ("_("                  "₍")
    ("_)"                  "₎")
    ("_a"                  "ₐ")
    ("_e"                  "ₑ")
    ("_o"                  "ₒ")
    ("_x"                  "ₓ")
    ("^0"                  "⁰")
    ("^i"                  "ⁱ")
    ("^1"                  "¹")
    ("^2"                  "²")
    ("^3"                  "³")
    ("^4"                  "⁴")
    ("^5"                  "⁵")
    ("^6"                  "⁶")
    ("^7"                  "⁷")
    ("^8"                  "⁸")
    ("^9"                  "⁹")
    ("^+"                  "⁺")
    ("^-"                  "⁻")
    ("^="                  "⁼")
    ("^("                  "⁽")
    ("^)"                  "⁾")
    ("^n"                  "ⁿ")
    ) ; scripts ends

  (backspace
   ((BackSpace)))

