(input-method vi telex)

(description (_"Vietnames input method using the TELEX key sequence.
Typing Backslash ('\\') toggles the normal mode and English mode.
The following variables are customizable:
  tone-mark-on-last: control tone mark position in equivocal cases
  backspace-is-undo: control the action of Backspace key (delete or undo)"))

(title "Ắ(TLX)")

(variable
 (tone-mark-on-last
  (_"Flag to control tone mark position in equivocal cases.
If this variable is 1 (the default), put tone mark on the last vowel
in such equivocal cases as \"oa\", \"oe\", \"uy\" (e.g. \"hoà\").
If the value is 0, put tone mark on the first vowel (e.g. \"hòa\").")
  1 0 1)

 (backspace-is-undo
  (_"Flag to control the action of Backspace key (delete or undo).
If this variable is 0 (the default), Backspace key deletes the previous
character (e.g. \"q u a i s BS\" => \"quá\").
If the value is 1, Backspace key undoes the previous key
\(e.g. \"q u a i s BS\" => \"quai\").")
  0 0 1))

(include (t nil vi-base) macro)
(include (t nil vi-base) map)

(macro
 (restore-keys
  ;; Drop the marks put so far and replay every key of this word as is.
  (delete @<) (shift restore) (pushback 0))

 ;; Lowercase the letters in P and Q.
 (lower-pq
  (cond ((& (>= P ?A) (<= P ?Z)) (add P 32))
	((= P ?Đ) (set P ?đ))
	((= P ?Ư) (set P ?ư))
	((= P ?Ơ) (set P ?ơ)))
  (cond ((& (>= Q ?A) (<= Q ?Z)) (add Q 32))))

 ;; BAD is 1 if the last two letters start English words only (show,
 ;; class, smart).  Pairs found in names from the Central Highlands
 ;; (Krông, Hmông, Pleiku, Stiêng) are not listed.
 (check-initial
  (set P @-2) (set Q @-1) (lower-pq)
  (set BAD (| (& (= P ?s) (| (= Q ?h) (= Q ?c) (= Q ?k) (= Q ?m) (= Q ?n)
			     (= Q ?p)))
	      (& (| (= P ?c) (= P ?g)) (| (= Q ?l) (= Q ?r)))
	      (& (= P ?k) (= Q ?n)))))

 ;; BAD is 1 if the vowel just typed cannot follow the previous one
 ;; (cafe, your, search, web).
 (check-vowel-pair
  (set P V-1) (set Q @-1) (lower-pq)
  (set INITIAL (| (& (>= C ?a) (<= C ?z)) (& (>= C ?A) (<= C ?Z))
		  (= C ?đ) (= C ?Đ)))
  (set GI (& (| (= C ?g) (= C ?G)) (| (= V-1 ?i) (= V-1 ?I))))
  (set BAD (| (& (= P ?a) (= Q ?e)) (& (= P ?e) (= Q ?a))
	      (& (= P ?e) (| (= Q ?i) (= Q ?y)))
	      (& (= P ?i) (| (= Q ?i) (= Q ?y)) (! GI))
	      (& (= P ?i) (= Q ?o) (! GI))
	      (& (= P ?o) (| (= Q ?u) (= Q ?y)))
	      (& (= P ?y) (| (= Q ?i) (= Q ?o)))
	      (& (= P ?y) (| (= Q ?a) (= Q ?u))
		 (! (| (= V-2 ?u) (= V-2 ?U))))
	      (& (= P ?ư) (| (= Q ?e) (= Q ?y) (& (= Q ?i) (! INITIAL))))
	      ;; power, way: w gives ơ or ư, and nothing in Vietnamese
	      ;; continues them like this.
	      (& (= P ?ơ) (= Q ?e))
	      (& (= P ?a) (| (= Q ?y) (= Q ?i)) (| (= V-2 ?ư) (= V-2 ?Ư))))))

 ;; BAD is 1 if no final consonant can follow the vowels typed
 ;; (using, axit, virut).  Exceptions: quít, giun, giòn.
 (check-final
  (set P V-1) (set Q V-2) (lower-pq)
  (set GI (& (| (= C ?g) (= C ?G)) (= Q ?i)))
  (set QU (& (| (= C ?q) (= C ?Q)) (= Q ?u)))
  (set BAD (& (! (= Q 0))
	      (| (& (= P ?i) (! QU) (! GI))
		 (& (= P ?u) (! GI))
		 (& (= P ?o) (| (= Q ?a) (= Q ?e)))
		 (& (= P ?y) (| (= Q ?a) (= Q ?â) (= Q ?Â)))
		 (& (= P ?a) (= Q ?ư))))))

 ;; BAD is 1 if the tone cannot go with a final c, ch, p, t or k, which
 ;; take only the acute and the dot below (text, part, soft).
 (check-stop-tone
  (set BAD (& STOP (> SELECT 1) (< SELECT 5))))

 (final-consonant
  (check-final)
  (set P @-1) (set Q 0) (lower-pq)
  (set STOP (| (= P ?c) (= P ?p) (= P ?t) (= P ?k)))
  (cond ((! BAD) (check-stop-tone)))
  (cond (BAD (restore-keys))
	(1 (fix-uo-before-consonant) (handle-mark)
	   (set C-AFTER-V 1) (shift after-vc)))))

(map
 (vowel-ext
  ("aa" ("âấầẩẫậ")) ("AA" ("ÂẤẦẨẪẬ")) ("Aa" ("ÂẤẦẨẪẬ"))
  ("aw" ("ăắằẳẵặ")) ("AW" ("ĂẮẰẲẴẶ")) ("Aw" ("ĂẮẰẲẴẶ"))
  ("ee" ("êếềểễệ")) ("EE" ("ÊẾỀỂỄỆ")) ("Ee" ("ÊẾỀỂỄỆ"))
  ("oo" ("ôốồổỗộ")) ("OO" ("ÔỐỒỔỖỘ")) ("Oo" ("ÔỐỒỔỖỘ"))
  ("ow" ("ơớờởỡợ")) ("OW" ("ƠỚỜỞỠỢ")) ("Ow" ("ƠỚỜỞỠỢ"))
  ("uw" ("ưứừửữự")) ("UW" ("ƯỨỪỬỮỰ")) ("Uw" ("ƯỨỪỬỮỰ"))
  ("w"  (cond ((= V-1 0) ("ưứừửữự")) (1 "w"))) ; Works when it's the
  ("W"  (cond ((= V-1 0) ("ƯỨỪỬỮỰ")) (1 "W"))) ; first vowel (not seư)
  ("ooo" ("oóòỏõọ") ("oóòỏõọ") (set V-2 V-1) (set V-1 ?o))
  ("OOO" ("OÓÒỎÕỌ") ("OÓÒỎÕỌ") (set V-2 V-1) (set V-1 ?O))
  ("Ooo" ("OÓÒỎÕỌ") ("oóòỏõọ") (set V-2 V-1) (set V-1 ?O)))

 (consonant-ext
  ("dd" ?đ) ("DD" ?Đ) ("Dd" ?Đ))
  ;("dd" (cond ((= C-AFTER-V 0) "dd") (1 ?đ))) ; Works when
  ;("DD" (cond ((= C-AFTER-V 0) "DD") (1 ?Đ))) ; it is the first
  ;("Dd" (cond ((= C-AFTER-V 0) "Dd") (1 ?Đ)))) ; letter (not ađ)

 (tone-mark
  ("z" (set SELECT 0) ?z) ("Z" (set SELECT 0) ?Z)
  ("s" (set SELECT 1) ?s) ("S" (set SELECT 1) ?S)
  ("f" (set SELECT 2) ?f) ("F" (set SELECT 2) ?F)
  ("r" (set SELECT 3) ?r) ("R" (set SELECT 3) ?R)
  ("x" (set SELECT 4) ?x) ("X" (set SELECT 4) ?X)
  ("j" (set SELECT 5) ?j) ("J" (set SELECT 5) ?J))

 ;; A mark key after a final consonant.  Unlike vowel-ext, nothing
 ;; longer starts with these keys, so khongo shows "không" at once.
 (late-mark-key
  ("a" (set KEY ?a)) ("e" (set KEY ?e)) ("o" (set KEY ?o)) ("w" (set KEY ?w))
  ("A" (set KEY ?A)) ("E" (set KEY ?E)) ("O" (set KEY ?O)) ("W" (set KEY ?W)))

 (consonant-or-tone-mark
  ("z" ?z) ("s" ?s) ("f" ?f) ("r" ?r) ("x" ?x) ("j" ?j)
  ("Z" ?Z) ("S" ?S) ("F" ?F) ("R" ?R) ("X" ?X) ("J" ?J))

 (temporary-escape
  ("aaa" "aa") ("AAA" "AA") ("Aaa" "Aa")
  ("eee" "ee") ("EEE" "EE") ("Eee" "Ee")
  ("ddd" "dd") ("DDD" "DD") ("Ddd" "Dd")
  ("aww" "aw") ("AWW" "AW") ("Aww" "Aw")
  ("uww" "uw") ("UWW" "UW") ("Uww" "Uw")
  ("oww" "ow") ("OWW" "OW") ("Oww" "Ow")
  ("ww" ?w) ("WW" ?W) ("Ww" ?W)
  ("zz" ?z) ("ZZ" ?Z) ("Zz" ?Z)
  ("ss" ?s) ("SS" ?S) ("Ss" ?S)
  ("ff" ?f) ("FF" ?F) ("Ff" ?F)
  ("rr" ?r) ("RR" ?R) ("Rr" ?R)
  ("xx" ?x) ("XX" ?X) ("Xx" ?X)
  ("jj" ?j) ("JJ" ?J) ("Jj" ?J)))

(state
 (init
  ;; Initialize variables.  C is the initial consonant.  V-N is the
  ;; (N-1)th vowel from the last.  C-AFTER-V is a number of consonants
  ;; typed after vowel.  NST is 1 iff surrounding text is not supported.
  (t (set C @-1) (set V-1 0) (set V-2 0) (set V-3 0) (set C-AFTER-V 0)
     (set SELECT 0) (set STOP 0) (set NST (= @-0 -2)))

  (consonant (check-initial)
	     (cond (BAD (shift temporary-escape))
		   (1 (set C @-1) (cond (NST (shift after-c))))))
  (consonant-ext (set C @-1) (cond (NST (shift after-c))))
  (consonant-or-tone-mark
   (check-initial)
   (cond ((| (= @-1 ?f) (= @-1 ?j) (= @-1 ?z) ; Invalid beginning consonants
             (= @-1 ?F) (= @-1 ?J) (= @-1 ?Z)) (shift temporary-escape))
	 (BAD (shift temporary-escape))
         (1 (set C @-1) (cond (NST (shift after-c))))))

  ;; Mark M remembers the preedit position after the last vowel.
  (vowel (mark M) (set V-2 V-1) (set V-1 @-1) (shift after-v))
  (vowel-ext (mark M) (set V-2 V-1) (set V-1 @-1) (shift after-v))
  (temporary-escape (shift temporary-escape))
  (permanent-escape (shift escape-in-normal-mode))
  (smart-quotes))

 ;; The state shifted to when an initial consonants is typed and
 ;; surrounding text is not supported.
 (after-c
  (consonant (check-initial)
	     (cond (BAD (shift temporary-escape)) (1 (set C @-1))))
  (consonant-or-tone-mark
   (check-initial) (cond (BAD (shift temporary-escape)) (1 (set C @-1))))
  (vowel (mark M) (set V-2 V-1) (set V-1 @-1) (shift after-v))
  (vowel-ext (mark M) (set V-2 V-1) (set V-1 @-1) (shift after-v)))

 ;; The state shifted to when a vowel is typed.
 (after-v
  (ending-1st-consonant (final-consonant)) ; toans/toasn->toán
  (vowel (set KEY @-1)
	 ;; "oeo" and "oao" are vowels of their own (ngoẻo).
	 (cond ((& (| (= KEY ?o) (= KEY ?O))
		   (| (= V-1 ?e) (= V-1 ?E) (= V-1 ?a) (= V-1 ?A)))
		(set KEY 0)))
	 (late-mark)
	 (cond (K (delete @-) (handle-mark))
	       (1 (check-vowel-pair)
		  (cond (BAD (restore-keys)) (1 (add-vowel))))))
  (vowel-ext (set KEY @-1) (late-mark)
	     (cond (K (delete @-) (handle-mark))
		   ;; No Vietnamese word has ư before ê (tweet).
		   ((& (| (= @-1 ?ê) (= @-1 ?Ê)) (| (= V-1 ?ư) (= V-1 ?Ư)))
		    (restore-keys))
		   (1 (w-after-vowel))))
  ;; k ends place names such as Đắk Lắk, Krông Búk and Srê Pốk, after a
  ;; single a, ă, ô or u only, so that disk or work stay English.
  (ending-1st-notviet-consonant
   (cond ((& (| (= @-1 ?k) (= @-1 ?K)) (= V-2 0)
	     (| (= V-1 ?a) (= V-1 ?A) (= V-1 ?ă) (= V-1 ?Ă)
		(= V-1 ?ô) (= V-1 ?Ô) (= V-1 ?u) (= V-1 ?U)))
	  (final-consonant))
	 (1 (restore-keys))))
  (consonant-or-tone-mark (delete @-) (pushback 1) (shift after-t))
  (backspace (delete @-)
	     (cond (V-3 (set V-1 V-2) (set V-2 V-3) (set V-3 0)
			(cond ((> TPLACE 2) (set SELECT 0)))
			(handle-mark))
		   (V-2 (set V-1 V-2) (set V-2 0)
			(cond ((> TPLACE 1) (set SELECT 0)))
			(handle-mark))
		   (1 (shift init)))))

 ;; The state shifted to when a consonant is typed after a vowel.
 (after-vc
  (ending-2nd-consonant
   (cond ((| (= @-2 ?n) (= @-2 ?c) ; 1st ending consonant must be n/c
             (= @-2 ?N) (= @-2 ?C)) (add C-AFTER-V 1))
         (1 (restore-keys))))
  (ending-1st-notviet-consonant (restore-keys))
  (consonant-or-tone-mark (delete @-) (pushback 1) (shift after-t))
  ;; There can only be one main vowel in a word, but a circumflex,
  ;; breve or horn key may still mark it (vietej -> việt).
  (late-mark-key (late-mark)
		 (cond (K (handle-mark)) (1 (restore-keys))))
  (vowel (restore-keys))
  ;; The only final consonant pairs are ng, nh, ch (internet, tennis).
  (consonant (restore-keys))
  (backspace (delete @-)
	     (sub C-AFTER-V 1)
	     (handle-mark)
	     (cond ((= C-AFTER-V 0) (set STOP 0) (shift after-v)))))

 ;; The state shifted to when a tone-mark is typed.
 (after-t
  (t (set CURRENT-SELECT -1))
  (tone-mark (cond ((= CURRENT-SELECT SELECT) (move T) (select 0) (move @>)
		    (shift temporary-escape))
		   (1 (check-stop-tone)
		      (cond (BAD (restore-keys))
			    (1 (delete @-) (handle-mark)
			       (set CURRENT-SELECT SELECT))))))
  (nil (cond (C-AFTER-V (shift after-vc))
	     (1 (shift after-v)))))

 (temporary-escape
  "en"
  (t (commit))
  (alnum (commit)))

 ;; Reached when the keys typed so far cannot be a Vietnamese word.
 ;; The keys are typed again as plain letters (casino, server).
 ;; Backspace reads the remaining keys again, so "serv BS BS e" gives sê.
 (restore
  "en"
  (alnum)
  (backspace (cond ((= backspace-is-undo 0) (undo)))))

 (escape-in-normal-mode
  "EN"
  (permanent-escape (insert "\\") (shift init))
  ;; Any other key force shifting to permanent-escape.
  (nil (shift permanent-escape)))

 (permanent-escape
  "EN"
  (t (set ESCAPE 1))
  (permanent-escape (shift escape-in-permanent-escape))
  ;; Unhandle any characters.
  (nil (unhandle)))

 (escape-in-permanent-escape
  "Ắ"
  (permanent-escape (insert "\\") (commit) (shift permanent-escape))
  ;; Any other key force shifting to init
  ))

;; Local Variables:
;; coding: utf-8
;; mode: emacs-lisp
;; End:
